  "components": [
    {
      "name": "Save Draft",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary browser-local draft action.",
      "html": "<button class=\"ds-save\">Save Draft</button>",
      "css": ".ds-save{font-family:Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:36px;padding:7px 14px;border:1px solid #e1e8e5;border-radius:8px;font-size:12px;font-weight:600;line-height:1.5;cursor:pointer;white-space:nowrap;transition:background-color 140ms ease-out,border-color 140ms ease-out;background:#197b53;color:#fff;border-color:#197b53;}.ds-save:not(:disabled):hover{background:#126441;border-color:#126441;}.ds-save:focus-visible{outline:2px solid #197b53;outline-offset:3px;}.ds-save:disabled{opacity:.65;cursor:default;}@media(prefers-reduced-motion:reduce){.ds-save{transition:none;}}"
    },
    {
      "name": "Preview",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary report-preview action.",
      "html": "<button class=\"ds-preview\">Preview</button>",
      "css": ".ds-preview{font-family:Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:36px;padding:7px 14px;border:1px solid #e1e8e5;border-radius:8px;font-size:12px;font-weight:600;line-height:1.5;cursor:pointer;white-space:nowrap;transition:background-color 140ms ease-out,border-color 140ms ease-out;background:#fff;color:#122521;}.ds-preview:not(:disabled):hover{background:#f3f7f4;border-color:#a9bfb3;}.ds-preview:focus-visible{outline:2px solid #197b53;outline-offset:3px;}.ds-preview:disabled{opacity:.4;cursor:default;}@media(prefers-reduced-motion:reduce){.ds-preview{transition:none;}}"
    },
    {
      "name": "Formatting Tool",
      "kind": "button",
      "refersTo": "tool",
      "description": "Pressed formatting state with an inline bold icon.",
      "html": "<button class=\"ds-tool\" type=\"button\" aria-label=\"Bold\" aria-pressed=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 12h9a4 4 0 0 1 0 8H6z\"/><path d=\"M6 4h8a4 4 0 0 1 0 8H6z\"/></svg></button>",
      "css": ".ds-tool{display:inline-flex;align-items:center;justify-content:center;width:39px;height:30px;padding:0;border:1px solid #e1e8e4;border-radius:4px;background:#fff;color:#63776e;cursor:pointer;transition:background-color 140ms ease-out,border-color 140ms ease-out;}.ds-tool:not(:disabled):hover{background:#f8fcfa;border-color:#abc5b6;}.ds-tool[aria-pressed=\"true\"]{color:#16814f;border-color:#1da965;background:#e7f4eb;}.ds-tool:focus-visible{outline:2px solid #197b53;outline-offset:3px;}.ds-tool:disabled{opacity:.4;cursor:default;}@media(max-width:600px){.ds-tool{width:32px;height:32px;}}@media(prefers-reduced-motion:reduce){.ds-tool{transition:none;}}"
    },
    {
      "name": "Template Select",
      "kind": "input",
      "refersTo": "select",
      "description": "Native selection control with the corrected label color.",
      "html": "<span class=\"ds-select\"><select aria-label=\"Report template\"><option>Select template</option><option>Blank report</option></select><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></span>",
      "css": ".ds-select{font-family:Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;position:relative;height:36px;min-width:200px;border:1px solid #d3dfd8;border-radius:7px;background:#fff;color:#586b61;}.ds-select select{font-family:Arial,Helvetica,sans-serif;width:100%;height:100%;appearance:none;background:transparent;border:none;border-radius:inherit;padding:0 29px 0 11px;color:inherit;font-size:12px;cursor:pointer;}.ds-select select:focus-visible{outline:2px solid #197b53;outline-offset:3px;}.ds-select option{background:#fff;color:#122521;}.ds-select svg{position:absolute;right:10px;pointer-events:none;color:#71837a;}"
    },
    {
      "name": "Patient Context Chip",
      "kind": "chip",
      "refersTo": "context-chip",
      "description": "Compact patient context; unavailable values use an em dash.",
      "html": "<div class=\"ds-chip\"><span>Patient</span><strong>\u2014</strong></div>",
      "css": ".ds-chip{font-family:Arial,Helvetica,sans-serif;display:flex;align-items:center;gap:7px;min-width:0;max-width:300px;padding:4px 10px;border-radius:8px;background:#e9eeeb;color:#122521;white-space:nowrap;line-height:1.5;}.ds-chip span{flex-shrink:0;color:#586b61;font-size:9px;font-weight:700;letter-spacing:.055em;text-transform:uppercase;}.ds-chip strong{overflow:hidden;text-overflow:ellipsis;font-size:13px;font-weight:600;}"
    },
    {
      "name": "Patient Details",
      "kind": "card",
      "refersTo": "patient-details",
      "description": "Two-column metadata card that becomes one column on phones.",
      "html": "<dl class=\"ds-patient\"><div class=\"ds-field\"><dt>Patient name</dt><dd>\u2014</dd></div><div class=\"ds-field\"><dt>Patient ID</dt><dd>\u2014</dd></div></dl>",
      "css": ".ds-patient{font-family:Arial,Helvetica,sans-serif;display:grid;grid-template-columns:1fr 1fr;margin:0;padding:5px 22px;border:1px solid #e1e8e5;border-radius:10px;background:#fff;color:#122521;line-height:1.5;}.ds-field{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:43px;padding:8px;}.ds-field:nth-child(odd){margin-right:25px;}.ds-field:nth-child(even){position:relative;margin-left:25px;}.ds-field:nth-child(even):before{content:\"\";position:absolute;top:0;bottom:0;left:-26px;width:1px;background:#edf0ee;}.ds-field dt{color:#62746d;text-transform:uppercase;font-size:10px;font-weight:600;letter-spacing:.045em;flex-shrink:0;}.ds-field dd{margin:0;text-align:right;font-size:14px;overflow-wrap:anywhere;font-variant-numeric:tabular-nums;}@media(max-width:600px){.ds-patient{grid-template-columns:1fr;padding:6px 12px;}.ds-field{gap:14px;min-height:38px;padding:7px 0;margin:0!important;}.ds-field:before{display:none;}.ds-field:first-child{border-bottom:1px solid #edf0ee;}.ds-field dt{font-size:9px;}.ds-field dd{font-size:12px;}}"
    },
    {
      "name": "Report Document",
      "kind": "custom",
      "refersTo": "document",
      "description": "Editable document defaults, with no fabricated clinical content.",
      "html": "<div class=\"ds-document\" contenteditable=\"true\" role=\"textbox\" aria-label=\"Report content\" aria-multiline=\"true\"><h2>Findings</h2><p><br></p></div>",
      "css": ".ds-document{font-family:Arial,Helvetica,sans-serif;min-height:360px;padding:12px 0;outline:none;color:#122521;background:#fff;font-size:15px;line-height:1.7;caret-color:#197b53;overflow-wrap:anywhere;}.ds-document:focus-visible{outline:none;}.ds-document::selection,.ds-document ::selection{background:#d3eddf;color:#122521;}.ds-document h2{font-size:18px;font-weight:600;line-height:1.4;margin:0 0 8px;}.ds-document p{margin:0 0 12px;}@media(max-width:600px){.ds-document{min-height:250px;}}"
    },
